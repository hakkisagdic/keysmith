{
  "name": "keysmith-api",
  "version": "0.1.0",
  "description": "Forge an OpenAI-compatible API key out of any coding CLI. Bridges Command Code, opencode, Qoder CLI, GitHub Copilot, evren, Ollama & friends behind one /v1 endpoint, with failover, streaming and Cloudflare tunnel support.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "keysmith": "src/cli.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node --test",
    "start": "node src/cli.js serve"
  },
  "keywords": [
    "openai-compatible",
    "llm-gateway",
    "coding-agent",
    "cli",
    "opencode",
    "command-code",
    "copilot",
    "cloudflared",
    "byok"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hakkisagdic/keysmith.git"
  },
  "files": [
    "src",
    "examples",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "dependencies": {},
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.96",
    "@ai-sdk/openai": "4.0.108",
    "@ai-sdk/openai-compatible": "3.0.84",
    "@anthropic-ai/sdk": "1.4.0",
    "ai": "7.0.162",
    "openai": "7.50.0",
    "openbot-ai": "npm:ai@6.0.264",
    "openbot-ai-sdk-anthropic": "npm:@ai-sdk/anthropic@3.0.111",
    "openbot-ai-sdk-openai": "npm:@ai-sdk/openai@3.0.99",
    "openbot-openai": "npm:openai@7.5.0",
    "zod": "4.6.7"
  }
}
