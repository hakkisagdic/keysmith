# No runtime dependencies. The devDependencies (the client SDKs test/wire-conformance.test.js
# runs, pinned in package-lock.json) install here with `npm ci`.
node_modules/
.npm/

# Local state. The config file legitimately holds secret *references*, never secrets,
# but it is still your machine's wiring — do not commit it.
.config.json
keysmith.config.json
examples/config.local.json

# Runtime artifacts
*.log
*.pid
usage.jsonl
data/
.tmp/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp
